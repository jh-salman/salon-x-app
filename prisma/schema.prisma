// Salon X — Prisma schema (planning-first)
// This file is intentionally kept up-to-date alongside the mobile app,
// so backend implementation can be completed quickly later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------
// Core identities
// -----------------------------

model Client {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  photoUrl  String?

  // Long-term preferences / notes about the client (global, not visit-specific)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  clientNotes  ClientNote[]

  @@index([fullName])
  @@index([phone])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  body      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, createdAt])
}

// -----------------------------
// Catalog
// -----------------------------

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  durationMin Int?
  priceCents  Int?
  priceType   PriceType @default(FIXED)

  calendarColor String?

  requireDeposit Boolean @default(false)
  depositCents   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointmentServices AppointmentService[]

  @@index([name])
}

enum PriceType {
  FIXED
  STARTS_FROM
  VARIES
}

model Product {
  id         String   @id @default(cuid())
  brand      String
  name       String
  priceCents Int?
  imageUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usedInVisits           AppointmentProductUsed[]
  recommendedInVisits    AppointmentProductRecommendation[]

  @@index([brand])
  @@index([name])
}

// -----------------------------
// Appointments / visits
// -----------------------------

model Appointment {
  id        String   @id @default(cuid())

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)

  startAt   DateTime
  endAt     DateTime
  status    AppointmentStatus @default(BOOKED)

  seriesId  String?  // repeat support
  color     String?  // calendar tint (UI)
  isParked  Boolean  @default(false)

  // Optional note captured at booking time (modify form)
  bookingNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Visit details (experience cards)
  consultation AppointmentConsultation?
  services     AppointmentService[]
  productsUsed AppointmentProductUsed[]
  productRecommendations AppointmentProductRecommendation[]
  enhancement AppointmentEnhancement?
  nextVisitPlan AppointmentNextVisitPlan?

  checkout Checkout?

  @@index([clientId, startAt])
  @@index([status])
  @@index([seriesId])
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  PARKED
}

model AppointmentConsultation {
  appointmentId String @id
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Mirrors app UI: Today’s focus + consultation body
  techniqueNotes String[] @default([])
  personalNotes  String   @default("")

  // Store explicit duration for UI; can also be derived from appointment times
  durationMin Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // Snapshot so historical visits don't change when the catalog changes
  nameSnapshot  String
  priceCentsSnapshot Int? // cents

  completed     Boolean @default(false)
  orderIndex    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId, orderIndex])
  @@index([serviceId])
}

model AppointmentProductUsed {
  id            String @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  brandSnapshot String
  nameSnapshot  String
  priceCentsSnapshot Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([productId])
}

model AppointmentProductRecommendation {
  id            String @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot fields
  brandSnapshot String?
  nameSnapshot  String
  priceCentsSnapshot Int?
  reason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentId])
  @@index([productId])
}

model AppointmentEnhancement {
  appointmentId String @id
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  title         String // e.g. "Enhance result"
  suggestion    String // description
  serviceNameSnapshot String?
  priceCents    Int?
  accepted      Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentNextVisitPlan {
  appointmentId String @id
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  suggestedDate DateTime?
  suggestedAfterWeeks Int?
  suggestedServiceNameSnapshot String?
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------
// Checkout / payments (future)
// -----------------------------

model Checkout {
  id            String @id @default(cuid())
  appointmentId String @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  subtotalCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)
  status        CheckoutStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CheckoutStatus {
  PENDING
  PAID
  VOID
}

